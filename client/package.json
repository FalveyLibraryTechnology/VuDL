{
  "name": "vudl-client",
  "private": true,
  "engine": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "next build",
    "check-types": "tsc --noemit",
    "format": "prettier --check --write *.js *.ts components/** context/** pages/**",
    "lint": "prettier --check *.js *.ts components/** context/** pages/** && ESLINT_USE_FLAT_CONFIG=true eslint *.js components/ context/ pages/ -c eslint.config.mjs --max-warnings 0",
    "postinstall": "cp -r ./node_modules/tinymce ./public/",
    "prod": "next start",
    "snapshots": "jest --updateSnapshot",
    "start": "next dev",
    "test": "jest --coverage --no-cache",
    "testWatch": "jest --watch --coverage"
  },
  "dependencies": {
    "@date-io/dayjs": "^3",
    "@emotion/styled": "^11",
    "@mui/icons-material": "^7",
    "@mui/lab": "^5.0.0-alpha.177",
    "@mui/material": "^7",
    "@mui/x-date-pickers": "^8",
    "@mui/x-tree-view": "^8",
    "@tinymce/tinymce-react": "^6",
    "dayjs": "^1",
    "html-react-parser": "^5",
    "identity-obj-proxy": "^3.0.0",
    "next": "^16",
    "react": "^19",
    "roman-numerals": "^0.3.2",
    "tinymce": "^8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^5",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29",
    "@types/node": "^20",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8",
    "eslint": "^8",
    "eslint-config-next": "^15",
    "eslint-config-prettier": "^9",
    "eslint-plugin-prettier": "^5",
    "eslint-plugin-react": "^7",
    "eslint-plugin-jsdoc": "^62",
    "jest": "^29",
    "jest-environment-jsdom": "^29",
    "prettier": "^3",
    "react-dom": "^19",
    "react-test-renderer": "^19",
    "typescript": "^5",
    "typescript-eslint": "^8.52"
  }
}

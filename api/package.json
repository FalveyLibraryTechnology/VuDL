{
  "name": "vudl-api",
  "private": true,
  "engine": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "npx tsc",
    "format": "prettier --check --write *.js src/**",
    "lint": "prettier --check *.js src/** && ESLINT_USE_FLAT_CONFIG=true eslint *.js src/ -c eslint.config.mjs --max-warnings 0",
    "start:serverWatch": "nodemon --watch 'vudl.ini' --watch '**/*.ts' --watch '**/*.ejs' --ignore node_modules/ src/server.ts",
    "start:workerWatch": "nodemon --watch 'vudl.ini' --watch '**/*.ts' src/worker-start.ts",
    "start:server": "ts-node src/server.ts",
    "start:worker": "ts-node src/worker-start.ts",
    "saml:metadata": "ts-node src/saml-metadata.ts",
    "test": "jest --coverage --no-cache",
    "testWatch": "jest --watch --coverage",
    "watch": "npx tsc --watch"
  },
  "dependencies": {
    "@node-saml/passport-saml": "^5",
    "@stomp/stompjs": "^7.2.1",
    "@xmldom/xmldom": "^0.8",
    "body-parser": "^2.2.1",
    "bull-arena": "^4.9.2",
    "bullmq": "^5.7",
    "cookie-parser": "^1",
    "cors": "^2.8.5",
    "debug": "~4.4.3",
    "ejs": "^6",
    "express": "^5.2.1",
    "express-session": "^1",
    "formidable": "^3.5.4",
    "glob": "^13.0.0",
    "http-status-codes": "^2",
    "ini": "^6.0.0",
    "knex": "^3.1.0",
    "locutus": "^2",
    "morgan": "~1.11",
    "mysql2": "^3.16",
    "n3": "^2",
    "nanoid": "^5.1.6",
    "needle": "^3.1.0",
    "node-tesseract-ocr": "^2",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pdfkit": "^0.19",
    "sharp": "^0.34",
    "sqlite3": "^6",
    "tmp": "^0.2.1",
    "ts-node": "^10",
    "winston": "^3",
    "xml-escape": "^1.1.0",
    "xpath": "^0.0.34"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/jest": "^30",
    "@types/node": "^25",
    "@typescript-eslint/eslint-plugin": "^8.52",
    "@typescript-eslint/parser": "^8.52",
    "eslint": "^10",
    "eslint-config-prettier": "^10",
    "eslint-plugin-jsdoc": "^63",
    "eslint-plugin-prettier": "^5",
    "jest": "^30",
    "nodemon": "^3",
    "prettier": "^3",
    "supertest": "^7",
    "ts-jest": "^29",
    "typescript": "^5",
    "typescript-eslint": "^8.52"
  }
}
